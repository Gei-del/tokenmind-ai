# ============================================
# TokenMind AI - Backend Environment Variables
# NUNCA commitear el archivo .env real al repo
# ============================================

# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://tokenmind-api
AUTH0_CLIENT_ID=your_client_id_here

# Auth0 Management API (SOLO backend - NUNCA exponer al frontend)
AUTH0_MGMT_CLIENT_ID=your_mgmt_client_id
AUTH0_MGMT_CLIENT_SECRET=your_mgmt_client_secret_KEEP_SECRET

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

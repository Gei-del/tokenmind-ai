# ================================================
# TokenMind AI - Frontend Environment Variables
# NUNCA commitear el archivo .env.local real
# ================================================

# Auth0 - SDK Next.js (servidor)
AUTH0_SECRET=use_openssl_rand_hex_32_to_generate_this   # Secreto para encriptar cookies
AUTH0_BASE_URL=http://localhost:3000                     # URL base de la app
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com     # Tu dominio Auth0
AUTH0_CLIENT_ID=your_client_id_here                     # Client ID de la app Auth0
AUTH0_CLIENT_SECRET=your_client_secret_KEEP_SECRET      # Client Secret (SOLO en servidor)
AUTH0_AUDIENCE=https://tokenmind-api                    # Audience de la API

# Backend URL
BACKEND_URL=http://localhost:4000

# Auth0 - SDK (cliente) - solo variables públicas
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
